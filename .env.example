# DeployGuard Environment Configuration

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-to-a-secure-random-key
PORT=5000
HOST=127.0.0.1

# Database Configuration
# Local SQLite default (used when DATABASE_URL is not set or empty):
DATABASE_URL=sqlite:///deployguard.db
# Future Amazon RDS MySQL connection format:
# DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@<rds_endpoint>:3306/<database_name>

# Security Settings
# When set to false (default), blocks private, loopback and metadata IP addresses for SSRF prevention.
# Set to true ONLY for local automated testing environments.
ALLOW_LOCAL_HEALTHCHECKS=false
HEALTH_CHECK_TIMEOUT_SECONDS=5
MAX_RESPONSE_SIZE_BYTES=1048576

# Future AWS Integration Placeholders (Modular Services)
# AWS Region
AWS_REGION=us-east-1

# Amazon S3 for Incident Reports & Deployment Evidence
# STORAGE_PROVIDER: 'local' (default) or 's3'
STORAGE_PROVIDER=local
S3_BUCKET_NAME=your-deployguard-reports-bucket

# Amazon SNS for Incident Notifications
# NOTIFICATION_PROVIDER: 'local' (default) or 'sns'
NOTIFICATION_PROVIDER=local
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:deployguard-incident-alerts

# Amazon SQS for Background Health Checks
# QUEUE_PROVIDER: 'direct' (default) or 'sqs'
QUEUE_PROVIDER=direct
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/deployguard-checks-queue
